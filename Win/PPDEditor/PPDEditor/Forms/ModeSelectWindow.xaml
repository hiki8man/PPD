<Window x:Class="PPDEditor.Forms.ModeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPDEditor Mod - 选择脚本预览版本"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/ed.ico">
    <StackPanel Margin="18,16,18,16">
        <TextBlock Text="请选择启动时的脚本预览版本（不影响谱面工程文件）："
                   TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold" />

        <RadioButton x:Name="vet08hRadio" GroupName="ScriptMode" Margin="0,4,0,6">
            <StackPanel>
                <TextBlock Text="Vet08H（VectorReverse08H）" FontWeight="SemiBold" />
                <TextBlock Text="60FPS 变速模拟 + MarkDistanceRatio / Frequency / SubtractBPM"
                           Foreground="Gray" FontSize="11" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="vet08Radio" GroupName="ScriptMode" Margin="0,4,0,6">
            <StackPanel>
                <TextBlock Text="Vet08（VectorReverse08）" FontWeight="SemiBold" />
                <TextBlock Text="60FPS 变速模拟 + MarkDistance / Curvature / DecelerationRate"
                           Foreground="Gray" FontSize="11" />
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="divascriptRadio" GroupName="ScriptMode" Margin="0,4,0,12">
            <StackPanel>
                <TextBlock Text="DivaScript" FontWeight="SemiBold" />
                <TextBlock Text="默认 BPM 120 + Frequency / Amplitude / Distance 参数公式"
                           Foreground="Gray" FontSize="11" />
            </StackPanel>
        </RadioButton>

        <CheckBox x:Name="rememberCheckBox"
                  Content="记住此选择，下次启动直接进入（可在顶部“模式”菜单修改）"
                  Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="启动" Width="88" Height="28" IsDefault="True" Click="OkButton_Click" Margin="0,0,8,0" />
            <Button Content="取消" Width="88" Height="28" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
